# SpecForge — Self-hosted environment configuration
# Copy this file to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://specforge:changeme@localhost:5432/specforge
POSTGRES_PASSWORD=changeme

# OpenAI credentials. Replit can supply AI_INTEGRATIONS_OPENAI_API_KEY and its base URL.
OPENAI_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────
# Notion Internal Integration token (from notion.so/my-integrations)
NOTION_API_KEY=secret_...

# ── OIDC Auth (Replit Auth by default) ───────────────────────────────────────
ISSUER_URL=https://replit.com/oidc
# For custom OIDC (self-hosted): set your own ISSUER_URL

# ── Local Dev Mode ───────────────────────────────────────────────────────────
# Set LOCAL_DEV=true to skip Replit Auth entirely (great for VS Code / local).
# A stable mock user is injected into every request automatically.
# Never enable this in production.
LOCAL_DEV=false
LOCAL_DEV_USER_ID=local-dev-user

# ── Public URL (used for OAuth callbacks and GitHub webhooks) ─────────────────
PUBLIC_URL=https://specforge.example.com

# ── Port ─────────────────────────────────────────────────────────────────────
PORT=8080
